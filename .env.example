# Environment variable template for local development.
# List every required variable here with a dummy value (never real secrets).
# Variables will be added by P0-4 (data sources) and P0-13 (dev scaffold).

# Dev stack (P0-13) — local development only, dummy values
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic-dev-password
POSTGRES_DB=traffic
POSTGRES_PORT=5432
REDIS_PORT=6379
MARTIN_PORT=3000
# Used by Python tools running on the host
DATABASE_URL=postgresql://traffic:traffic-dev-password@localhost:5432/traffic
REDIS_URL=redis://localhost:6379/0
