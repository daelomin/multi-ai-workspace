# Optional. Install: cp generic/loop-monitor.service ~/.config/systemd/user/ && systemctl --user enable --now loop-monitor
[Unit]
Description=Review-loop monitor and chainer (generic/loop_monitor.py)

[Service]
ExecStart=%h/GIT/multi-ai-workspace/generic/loop_monitor.py watch 30
Restart=on-failure

[Install]
WantedBy=default.target
